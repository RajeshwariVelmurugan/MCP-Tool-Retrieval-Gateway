# Copy to .env (never commit it).

# --- retrieval models ---
# Offline defaults need no downloads. Switch to real models for real results:
TOOLGATE_EMBEDDER=hash
TOOLGATE_RERANKER=heuristic
# TOOLGATE_EMBEDDER=fastembed:BAAI/bge-small-en-v1.5
# TOOLGATE_RERANKER=fastembed:Xenova/ms-marco-MiniLM-L-6-v2
# TOOLGATE_EMBEDDER=st:BAAI/bge-small-en-v1.5
# TOOLGATE_RERANKER=st:BAAI/bge-reranker-base
TOOLGATE_RERANK_DEPTH=30

# --- data locations (relative to project root) ---
# TOOLGATE_CORPUS=data/tools.json
# TOOLGATE_QUERIES=data/queries.json
# TOOLGATE_SERVERS=servers.json

# --- dashboard ---
TOOLGATE_PORT=8000

# --- gateway ---
# TOOLGATE_GATEWAY_METHOD=hybrid_rerank
# TOOLGATE_GATEWAY_LOG=1

# --- LLM end-to-end eval ---
# ANTHROPIC_API_KEY=
# TOOLGATE_E2E_MODEL=claude-haiku-5-5

# --- keys for downstream MCP servers referenced as ${VAR} in servers.json ---
# GITHUB_PERSONAL_ACCESS_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_TEAM_ID=
# BRAVE_API_KEY=
